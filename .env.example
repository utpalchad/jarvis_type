# Copy this file to .env.
# Never commit your real .env file.

# Gemini
GEMINI_API_KEY=
ADONIS_ACCESS_KEY=

# Server
PORT=3001
APP_URL=http://localhost:5173

# Optional Google Calendar + Gmail integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Optional trusted desktop companion.
# Leave blank unless you deliberately pair a local agent.
# Do not expose an unauthenticated local agent to the public internet.
LOCAL_AGENT_URL=
LOCAL_AGENT_TOKEN=
